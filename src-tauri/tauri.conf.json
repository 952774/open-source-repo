{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ToolArk",
  "version": "1.0.0",
  "identifier": "com.toolark.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ToolArk · 工具方舟",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.simpleicons.org https://raw.githubusercontent.com https://github.com https://opengraph.githubassets.com https://user-images.githubusercontent.com https://camo.githubusercontent.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://github.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNDczRDcwODU0NkVFQjQKUldTMDdrYUZjRDFIUXFybGZ5RVpaOEoxTTZKSGU1bEZ3Zm9oNThaeWNoSHoxOE9kbVFHWlpKTnQK",
      "endpoints": [
        "https://github.com/952774/open-source-repo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
